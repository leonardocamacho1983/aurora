# Copie este arquivo para .env e preencha com credenciais reais.
# NÃO comite o .env real.

# App em runtime — transaction pooler (IPv4-only, porta 6543).
# Na Vercel: mesmo valor de POSTGRES_URL (crie um alias DATABASE_URL se precisar).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres"

# Migrations (drizzle-kit) — conexão DIRETA / session mode (porta 5432).
# Na Vercel: mesmo valor de POSTGRES_URL_NON_POOLING.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Auth (@supabase/ssr) — públicas (client browser/server).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Server-only (jobs/admin). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Waitlist, convites e emails transacionais.
NEXT_PUBLIC_SITE_URL="https://www.faleaurora.com"
RESEND_API_KEY="re_..."
EMAIL_FROM="Aurora <ola@seudominio.com>"
WAITLIST_ADMIN_TOKEN="gere-um-token-longo-para-export-csv"
DESIGN_SYSTEM_ADMIN_TOKEN="gere-um-token-longo-para-design-system"
CRON_SECRET="gere-um-token-longo-para-cron"

# IA (§3). Server-only.
ANTHROPIC_API_KEY="<anthropic-key>"
OPENAI_API_KEY="<openai-key>"
